# cmake/DAWorkbenchConfig.cmake.in
@PACKAGE_INIT@

# include all export targets
include("${CMAKE_CURRENT_LIST_DIR}/DAWorkbenchTargets.cmake")

# 设置包级变量
set_and_check(DAWorkbench_INCLUDE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(DAWorkbench_LIBRARY_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")

# 所有 exported target 均在 DAWorkbenchTargets.cmake 中定义，
# 将其标记为已找到，供 check_required_components 校验组件可用性，
# 否则未设置的 <Pkg>_<comp>_FOUND 会被误判为组件缺失而把 DAWorkbench_FOUND 置 FALSE。
foreach(_da_comp DAUtils DAAxOfficeWrapper DAMessageHandler DAPyBindQt DAPyScripts
                 DAPyCommonWidgets DAPyWorkFlow DAData DAGraphicsView DAFigure DAGui
                 DAInterface DAPluginSupport DAAgent)
    if(TARGET DAWorkbench::${_da_comp})
        set(DAWorkbench_${_da_comp}_FOUND TRUE)
    endif()
endforeach()

check_required_components(DAWorkbench)